# Version 3 uses its own namespace and does not read Version 1 or 2 paths.
V3_PDF_DIRECTORY=data/documents/PDF Files
V3_CHROMA_PATH=chroma_db_v3
V3_COLLECTION_NAME=employee_policies_v3
V3_LLM_MODEL=llama3.2:3b
V3_EMBEDDING_MODEL=nomic-embed-text

# Ingestion and adaptive section splitting
V3_EMBEDDING_BATCH_SIZE=16
V3_MAX_CHUNK_WORDS=240
V3_CHUNK_OVERLAP_SENTENCES=1

# Hybrid retrieval, confidence, and diversity
V3_SEMANTIC_CANDIDATES=24
V3_LEXICAL_CANDIDATES=24
V3_TOP_K=6
V3_MAX_DISTANCE=0.85
V3_SEMANTIC_ONLY_MAX_DISTANCE=0.35
V3_RRF_CONSTANT=60
V3_DIVERSITY_WEIGHT=0.18
V3_MAX_CHUNKS_PER_SOURCE=2

# Conversation and prompt limits
V3_MEMORY_TURNS=8
V3_MAX_CONTEXT_CHARS=12000
